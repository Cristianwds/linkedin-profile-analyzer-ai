# Copiá este archivo a .env y completá los valores reales. NUNCA commitees el .env real.

# --- IDs de Drive/Sheets/Docs/Slides ---
ID_SPREADSHEET="id_de_tu_hoja_de_calculo"
ID_CARPETA="id_carpeta_origen_pdfs"
ID_CARPETA_INFORMES="id_carpeta_destino_informes"
ID_CARPETA_ANALIZADOS="id_carpeta_pdfs_analizados"
ID_PLANTILLA_INFORME="id_Informe_modelo"
ID_PRESENTACION_STATS="tu_id_de_presentacion"

# --- API keys de los proveedores de IA ---
GEMINI_API_KEY="tu_api_key_de_gemini_aqui"
GROQ_API_KEY="tu_key_de_groq"
NVIDIA_API_KEY="tu_key_de_nvidia"

# --- Panel web: login por persona ---
# Clave fija para firmar las cookies de sesión. Generála una vez con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# y pegala acá. Si la dejás vacía, el server genera una al azar en cada arranque y desloguea
# a todo el mundo cada vez que reinicia.
SESSION_SECRET=

# Opcional: restringe el login a un dominio de Google Workspace (ej. udesa.edu.ar).
# Dejalo vacío para permitir cualquier cuenta de Google.
DOMINIO_PERMITIDO=

# Opcional: fuerza la redirect_uri del login (útil detrás de un proxy/Cloud Run). Si no se
# define, se deduce sola del request. Tiene que coincidir EXACTO con lo que está autorizado en
# el cliente OAuth de Google Cloud Console.
# OAUTH_REDIRECT_URI=https://tu-dominio.com/auth/callback

# Opcional: ruta al archivo de credenciales OAuth "Aplicación web" (ver README). Por defecto
# busca client_secret_web.json en la raíz del proyecto.
# GOOGLE_OAUTH_CLIENT_SECRETS_FILE=client_secret_web.json